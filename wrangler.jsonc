{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hku-entrepreneur-demo",
  "main": "./src/index.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "CONFESSIONS_DB",
      "database_name": "hku-message-board",
      "database_id": "00000000000000000000000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
