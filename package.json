{
  "name": "hku-entrepreneur-demo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-worker-site.mjs",
    "deploy": "wrangler deploy",
    "dev": "wrangler dev",
    "test": "node --test",
    "d1:create": "wrangler d1 create hku-message-board",
